$photos = [
    1 => 'https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?w=1200&q=80',
    2 => 'https://images.unsplash.com/photo-1555899434-94d1368aa7af?w=1200&q=80',
];
foreach ($photos as $id => $url) {
    $b = \App\Models\Branch::find($id);
    if ($b) {
        $b->photo = $url;
        $b->save();
        echo "Updated branch {$id}: {$b->name}\n";
    }
}
echo "Done\n";
